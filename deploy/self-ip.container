[Unit]
Description=Self IP
StartLimitBurst=5
StartLimitIntervalSec=30m

[Container]
ContainerName=self-ip
Image=ghcr.io/sintan1729/self-ip:latest
# Adjust if needed
PublishPort=3213:3213
AutoUpdate=registry
# Volumes
Volume=self-ip:/app/state
# Environment variables
# CHANGE IT BEFORE DEPLOYMENT, THIS IS GIBBERISH
Environment=SELF_IP_API_KEY=YlhMtBSKiSDuu9PiEinQWWA5QcFmoe0Lmar1g2N0m9vwYZoh67XeTTzbl0eKL14FUEjqBJwnr5SUli25wxjuew
Environment=SELF_IP_API_KEY_HASH_ALGORITHM=SHA512
# Environment=SELF_IP_TRUSTED_PROXIES=10.89.0.0/24
# Environment=SELF_IP_LISTEN_ADDR=0.0.0.0
# Environment=SELF_IP_LISTEN_PORT=1122
# Environment=SELF_IP_ENABLE_PORT_CHECKER=True
# Environment=SELF_IP_ENABLE_HOSTNAME=True
Environment=TZ=Asia/Kolkata
# Health check
HealthCmd=CMD-SHELL wget -qO- http://127.0.0.1:1729/healthz || exit 1
HealthInterval=60s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=10s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
